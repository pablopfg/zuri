{
  "name": "@zuri/agent",
  "version": "0.39.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var PUBLIC_URL:http://localhost:8787 --var TURNSTILE_SITE_KEY:1x00000000000000000000AA --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA",
    "build": "wrangler deploy --dry-run --outdir dist",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/openai": "4.0.109",
    "@modelcontextprotocol/client": "2.4.0",
    "@simplewebauthn/server": "14.0.3",
    "@zuri/shared": "*",
    "agents": "0.32.0",
    "ai": "7.0.163",
    "eventsource-parser": "4.1.3",
    "hono": "4.13.16",
    "workers-ai-provider": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "wrangler": "4.156.1"
  }
}
